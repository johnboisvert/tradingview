# ============================================================
# CryptoIA Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Admin Panel Credentials (REQUIRED for /admin access)
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# Google Gemini AI API Key (REQUIRED for AI Assistant)
# Get yours at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Backend API Base URL (optional, defaults to http://127.0.0.1:8000)
VITE_API_BASE_URL=

# Sentry Error Monitoring (optional — leave empty to disable Sentry)
# Get yours at: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=
# Tag releases with the deployment commit SHA (set automatically by Railway)
VITE_RELEASE=

# Dev server port (optional, defaults to 3000)
VITE_PORT=3000

# ─── Economic Calendar (page /calendrier) — SERVER SIDE ONLY ───
# These keys are read by server.js / vite.config.ts and are NEVER sent to the browser.
# Leave empty to use the built-in fallback programme (source "seed").
#
# Provider chain (first available wins): Trading Economics → Financial Modeling Prep → Alpha Vantage
# Recommended: "tradingeconomics" — https://tradingeconomics.com/calendar (API token on the account page)
#   Fallbacks: "fmp" (https://site.financialmodelingprep.com) or "alphavantage" (https://www.alphavantage.co)
ECONOMIC_API_PROVIDER=tradingeconomics
# API token for the selected provider (never prefix with VITE_)
ECONOMIC_API_KEY=

# ─── Chart AI (page /analyse-ia) — SERVER SIDE ONLY ───
# Uses VITE_GEMINI_API_KEY above (already required by the AI Assistant).
# The key is read by server.js / vite.config.ts and is NEVER sent to the browser.
# Optional: force a single model (default chain: gemini-3.1-pro-preview →
# gemini-2.5-pro → gemini-2.0-flash, first available wins).
# CHART_AI_MODEL=
# Optional: analyses per hour per IP on this public page (default 8).
# CHART_AI_MAX_PER_HOUR=8